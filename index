<!-- RULES -->
<div class="rules">
  <h2>Progression &amp; Stop Rules</h2>
  <ol>
    <li><b>Downclimb everything.</b> Impact from even low drops is the single biggest threat to the healing meniscus. No exceptions in any phase.</li>
    <li><b>24-hour rule.</b> Mild fatigue-type discomfort during a session is acceptable; any swelling, sharp pain, or joint-line pain lasting past the next morning means repeat the previous week — do not progress.</li>
    <li><b>Advance one variable at a time.</b> Angle, foothold size, or movement type — never two in the same week.</li>
    <li><b>Mirror every drill.</b> The operated leg must match the healthy side in smoothness and confidence before its loading increases.</li>
    <li><b>Phase gates:</b> enter Phase 2 only if all Phase 1 drills are pain-free for 2 consecutive sessions; same rule for Phase 3. Heel hooks require 2 pain-free drop-knee sessions first.</li>
    <li><b>Confirm clearance.</b> Twisting/pivoting progression (Phase 2 onward) should align with your surgical team's return-to-sport guidance.</li>
  </ol>
</div>

<!-- SESSION LOG -->
<h2>Session Log <span class="tag" style="background:#F0F2F5;color:var(--ink-soft)">Saved on this device</span></h2>
<p class="sub">Log every session with a pain score, then come back the next morning and tap the 24h check on the entry — that's the flag that governs the progression rules. Data lives in this browser's storage; use Export for a backup.</p>

<div class="log">
  <div class="log-form">
    <div class="lf">
      <label for="log-date">Date</label>
      <input type="date" id="log-date">
    </div>
    <div class="lf full">
      <label>Session</label>
      <div class="seg-btns" id="type-btns">
        <button data-v="A" class="on">A · Strength</button>
        <button data-v="B">B · Endur</button>
        <button data-v="R1">R1 · Z2</button>
        <button data-v="R2">R2 · SS</button>
        <button data-v="R3">R3 · Long</button>
      </div>
    </div>
    <div class="lf">
      <label>Phase</label>
      <div class="seg-btns" id="phase-btns">
        <button data-v="1" class="on">1</button>
        <button data-v="2">2</button>
        <button data-v="3">3</button>
      </div>
    </div>
    <div class="lf">
      <label for="log-pain">Knee pain during session (0–10)</label>
      <div class="pain-row">
        <input type="range" id="log-pain" min="0" max="10" step="1" value="0">
        <div class="pain-val" id="pain-val">0</div>
      </div>
    </div>
    <div class="lf full">
      <label for="log-notes">Notes — drills / intervals completed, cadence, what felt off</label>
      <textarea id="log-notes" placeholder="e.g. Sweet spot 3×8 @ 210W done, 88rpm, knee quiet throughout"></textarea>
    </div>
    <button class="save-btn" id="save-btn">Save Session</button>
  </div>

  <div class="log-stats">
    <div class="stat-box"><b id="st-total">0</b><span>Sessions</span></div>
    <div class="stat-box"><b id="st-week">0 / 2</b><span>This week</span></div>
    <div class="stat-box"><b id="st-pain">—</b><span>Avg pain · last 5</span></div>
  </div>
  <div class="trend" id="trend"></div>
  <div class="trend-label" id="trend-label">Pain trend — last 10 sessions</div>

  <div class="entries" id="entries"></div>

  <div class="log-tools">
    <button id="export-btn">Export JSON</button>
    <button id="clear-btn">Clear all</button>
  </div>
</div>

<script>
(function(){
  var KEY='sbkr_log_v1';
  var typeV='A', phaseV='1';

  function load(){ try{ return JSON.parse(localStorage.getItem(KEY))||[] }catch(e){ return [] } }
  function store(a){ try{ localStorage.setItem(KEY,JSON.stringify(a)) }catch(e){ alert('Could not save — storage unavailable.') } }
  function esc(s){ var d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
  function fmt(d){ var p=d.split('-'); return p[1]+'/'+p[2]+'/'+p[0].slice(2); }
  function weekStart(dt){ var d=new Date(dt); var day=(d.getDay()+6)%7; d.setDate(d.getDate()-day); d.setHours(0,0,0,0); return d; }

  function segInit(id, cb){
    var box=document.getElementById(id);
    box.addEventListener('click',function(e){
      var b=e.target.closest('button'); if(!b) return;
      box.querySelectorAll('button').forEach(function(x){x.classList.remove('on')});
      b.classList.add('on'); cb(b.dataset.v);
    });
  }
  segInit('type-btns',function(v){typeV=v});
  segInit('phase-btns',function(v){phaseV=v});

  var painEl=document.getElementById('log-pain');
  painEl.addEventListener('input',function(){ document.getElementById('pain-val').textContent=painEl.value; });

  var dateEl=document.getElementById('log-date');
  dateEl.value=new Date().toISOString().slice(0,10);

  function painChip(p){ return p<=2?'pain-lo':(p<=4?'pain-md':'pain-hi'); }

  function render(){
    var data=load().slice().sort(function(a,b){ return b.date.localeCompare(a.date)||b.id-a.id; });
    document.getElementById('st-total').textContent=data.length;

    var ws=weekStart(new Date());
    var wkEntries=data.filter(function(e){ return new Date(e.date+'T12:00')>=ws; });
    var wkClimb=wkEntries.filter(function(e){return e.type==='A'||e.type==='B'}).length;
    var wkBike=wkEntries.length-wkClimb;
    var stw=document.getElementById('st-week');
    stw.textContent=wkEntries.length+' / 5';
    stw.title='Climb '+wkClimb+'/2 · Bike '+wkBike+'/3';

    var last5=data.slice(0,5);
    document.getElementById('st-pain').textContent=last5.length?(last5.reduce(function(s,e){return s+e.pain},0)/last5.length).toFixed(1):'—';

    var t=document.getElementById('trend'); t.innerHTML='';
    var last10=data.slice(0,10).reverse();
    last10.forEach(function(e){
      var d=document.createElement('div');
      d.style.height=Math.max(8,e.pain*10)+'%';
      if(e.pain>=5) d.className='hi';
      d.title=fmt(e.date)+' · pain '+e.pain;
      t.appendChild(d);
    });
    document.getElementById('trend-label').style.display=last10.length?'block':'none';
    t.style.display=last10.length?'flex':'none';

    var box=document.getElementById('entries'); box.innerHTML='';
    if(!data.length){ box.innerHTML='<div class="empty-log">No sessions logged yet — first one starts the clock.</div>'; return; }
    data.forEach(function(e){
      var div=document.createElement('div'); div.className='entry';
      var flagBtn = e.flag24===true ? '<button class="flag-on" data-act="flag" data-id="'+e.id+'">⚠ 24h: swelling/pain</button>'
                  : e.flag24===false ? '<button class="flag-ok" data-act="flag" data-id="'+e.id+'">✓ 24h: clear</button>'
                  : '<button data-act="flag" data-id="'+e.id+'">24h check — tap tomorrow</button>';
      var tCls = e.type==='A' ? 'a' : (e.type==='B' ? 'b' : 'r');
      var tLbl = e.type==='A' ? 'Climb A' : (e.type==='B' ? 'Climb B' : 'Ride '+String(e.type).slice(1));
      div.innerHTML =
        '<div class="entry-top"><span class="d">'+fmt(e.date)+'</span>'+
        '<span class="chip '+tCls+'">'+tLbl+'</span>'+
        '<span class="chip p">Phase '+e.phase+'</span>'+
        '<span class="chip '+painChip(e.pain)+'">Pain '+e.pain+'</span></div>'+
        (e.notes?'<div class="note-txt">'+esc(e.notes)+'</div>':'')+
        '<div class="entry-actions">'+flagBtn+
        '<button data-act="del" data-id="'+e.id+'">Delete</button></div>';
      box.appendChild(div);
    });
  }

  document.getElementById('save-btn').addEventListener('click',function(){
    var data=load();
    data.push({ id:Date.now(), date:dateEl.value, type:typeV, phase:phaseV,
      pain:parseInt(painEl.value,10), notes:document.getElementById('log-notes').value.trim(), flag24:null });
    store(data);
    document.getElementById('log-notes').value='';
    painEl.value=0; document.getElementById('pain-val').textContent='0';
    render();
    if(data.length>0 && data.length%5===0){
      if(confirm('You\u2019ve logged '+data.length+' sessions \u2014 copy a JSON backup to clipboard? (Safari can purge site storage after long inactivity.)')) doExport();
    }
  });

  document.getElementById('entries').addEventListener('click',function(e){
    var b=e.target.closest('button'); if(!b) return;
    var id=Number(b.dataset.id); var data=load();
    var i=data.findIndex(function(x){return x.id===id}); if(i<0) return;
    if(b.dataset.act==='del'){
      if(!confirm('Delete this session?')) return;
      data.splice(i,1);
    } else {
      // cycle: unchecked -> clear -> flagged -> unchecked
      data[i].flag24 = data[i].flag24===null ? false : (data[i].flag24===false ? true : null);
      if(data[i].flag24===true) alert('24h flag set. Per the stop rules: repeat the previous week — do not progress.');
    }
    store(data); render();
  });

  function doExport(){
    var txt=JSON.stringify(load(),null,2);
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(txt).then(function(){alert('Log copied to clipboard as JSON.')},function(){prompt('Copy your log:',txt)});
    } else { prompt('Copy your log:',txt); }
  }
  document.getElementById('export-btn').addEventListener('click',doExport);

  document.getElementById('clear-btn').addEventListener('click',function(){
    if(confirm('Delete ALL logged sessions? This cannot be undone.')){ store([]); render(); }
  });

  /* ---- auto-detect today: highlight day + pre-select session ---- */
  var DMAP={1:'A',2:'R1',3:null,4:'B',5:'R2',6:'R3',0:null};
  (function(){
    var idx=(new Date().getDay()+6)%7;
    var cells=document.querySelectorAll('.week .day');
    if(cells[idx]) cells[idx].classList.add('today');
    var pre=DMAP[new Date().getDay()];
    if(pre){
      document.querySelectorAll('#type-btns button').forEach(function(b){
        b.classList.toggle('on', b.dataset.v===pre);
      });
      typeV=pre;
    }
  })();

  /* ---- phase auto-tracking from plan start date ---- */
  var SKEY='sbkr_start_v1';
  var startEl2=document.getElementById('start-date');
  function applyStart(){
    var v=startEl2.value, badge=document.getElementById('wk-badge');
    if(!v){ badge.textContent='Set start date'; return; }
    var days=Math.floor((new Date()-new Date(v+'T00:00'))/86400000);
    if(days<0){ badge.textContent='Starts '+fmt(v); return; }
    var wk=Math.floor(days/7)+1;
    var ph=wk<=3?1:(wk<=6?2:3);
    badge.textContent='Week '+wk+' \u00b7 Phase '+ph;
    [1,2,3].forEach(function(n){
      var d=document.getElementById('phase'+n); if(d) d.open=(n===ph);
    });
    phaseV=String(ph);
    document.querySelectorAll('#phase-btns button').forEach(function(b){
      b.classList.toggle('on', b.dataset.v===phaseV);
    });
  }
  var sv=null; try{ sv=localStorage.getItem(SKEY) }catch(e){}
  if(sv) startEl2.value=sv;
  startEl2.addEventListener('change',function(){
    try{ localStorage.setItem(SKEY,startEl2.value) }catch(e){}
    applyStart();
  });
  applyStart();

  /* ---- rest timers: tap any mm:ss cell ---- */
  var bar=document.createElement('div'); bar.id='timerbar';
  bar.innerHTML='<b id="tb-time">0:00</b><span id="tb-label">Rest timer \u2014 tap to cancel</span>';
  document.body.appendChild(bar);
  var tInt=null, tEnd=0, actx=null;
  function beep(){
    try{
      actx=actx||new (window.AudioContext||window.webkitAudioContext)();
      var now=actx.currentTime;
      [0,0.3,0.6].forEach(function(off){
        var o=actx.createOscillator(), g=actx.createGain();
        o.frequency.value=880; o.connect(g); g.connect(actx.destination);
        g.gain.setValueAtTime(0.25, now+off);
        g.gain.exponentialRampToValueAtTime(0.001, now+off+0.25);
        o.start(now+off); o.stop(now+off+0.26);
      });
    }catch(e){}
    if(navigator.vibrate) navigator.vibrate([200,100,200]);
  }
  function tick(){
    var s=Math.max(0, Math.round((tEnd-Date.now())/1000));
    document.getElementById('tb-time').textContent=Math.floor(s/60)+':'+('0'+s%60).slice(-2);
    if(s<=0){
      clearInterval(tInt); tInt=null;
      bar.classList.add('done');
      document.getElementById('tb-label').textContent='Rest done \u2014 tap to dismiss';
      beep();
    }
  }
  function startTimer(sec){
    try{
      actx=actx||new (window.AudioContext||window.webkitAudioContext)();
      if(actx.state==='suspended') actx.resume();
    }catch(e){}
    if(tInt) clearInterval(tInt);
    bar.classList.remove('done'); bar.classList.add('on');
    document.getElementById('tb-label').textContent='Rest timer \u2014 tap to cancel';
    tEnd=Date.now()+sec*1000; tick();
    tInt=setInterval(tick,250);
  }
  bar.addEventListener('click',function(){
    if(tInt){ clearInterval(tInt); tInt=null; }
    bar.classList.remove('on','done');
  });
  document.querySelectorAll('td.num').forEach(function(td){
    var m=td.textContent.trim().match(/^(\d{1,2}):(\d{2})\b/);
    if(!m || td.textContent.indexOf('\u00d7')>-1) return;
    td.classList.add('t-timer'); td.title='Tap to start timer';
    td.addEventListener('click',function(){
      startTimer(parseInt(m[1],10)*60 + parseInt(m[2],10));
    });
  });

  /* ---- offline: register service worker ---- */
  if('serviceWorker' in navigator){
    try{ navigator.serviceWorker.register('./sw.js') }catch(e){}
  }

  // Weekly layout day links: open the target section, then scroll to it
  document.querySelectorAll('.act[data-target]').forEach(function(el){
    el.addEventListener('click',function(){
      var t=el.getAttribute('data-target'), node;
      if(t==='phase'){
        node=document.querySelector('details.phase[open]')||document.getElementById('phase1');
      } else {
        node=document.querySelector(t);
      }
      if(!node) return;
      if(node.tagName==='DETAILS') node.open=true;
      var d=node.closest('details'); if(d) d.open=true;
      node.scrollIntoView({behavior:'smooth',block:'start'});
    });
  });

  render();
})();
</script>

<footer>
  <b style="color:var(--ink)">Key</b> ·
  FTP = Functional Threshold Power, the highest power (watts) sustainable for ~1 hour; all ride targets are % of this ·
  ERG = trainer mode that holds a fixed power target regardless of gear or cadence ·
  TSS = Training Stress Score, workout load relative to 1 hour at FTP (100 = 1h all-out) ·
  Z2 = Zone 2, easy aerobic intensity (~60–70% FTP), conversational ·
  SS = Sweet Spot, just below threshold (~88–92% FTP) ·
  rpm = pedal revolutions per minute (cadence) ·
  RPE = Rate of Perceived Exertion, 1–10 ·
  ARC = Aerobic Restoration &amp; Capillarity, continuous low-intensity climbing without pumping out ·
  4×4 = 4 circuits climbed back-to-back, repeated for 4 sets ·
  Mirrored = identical sequence performed on left and right sides of the systems grid ·
  R1/R2/R3 = Rides 1–3 in the weekly layout ·
  24h flag = swelling or sharp pain the morning after a session (see stop rules)
  <br><br>General training guidance — not medical advice; progress per your surgeon/PT's clearance.
</footer>

</div>
</body>
</html>
